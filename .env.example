# Environment Variables Example
# Copy this file to .env.local and fill in your values
# Only VITE_ prefixed variables are exposed to the client bundle

# API Configuration
# VITE_API_URL=http://localhost:3000
# VITE_API_TIMEOUT=30000

# App Configuration
# VITE_APP_NAME=TypeScript Frontend Example
# VITE_APP_VERSION=1.0.0

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

# Third-party Services (only public keys, never secrets!)
# VITE_PUBLIC_API_KEY=

# SECURITY NOTE:
# - Never commit .env files with real values to version control
# - Only use VITE_ prefix for variables that should be exposed to the client
# - Never expose secrets, private keys, or sensitive credentials
# - Use backend APIs to handle sensitive operations
